rules_version = '2';
// ArcRise Firestore kuralları.
// Deploy: Firebase Console > Firestore Database > Rules sekmesine yapıştır > Publish.
//
// Not: Client'ta auth olmadığı için kayıt sahipliği doğrulanamıyor —
// bu kurallar yine de en büyük riskleri kapatır:
//   - DELETE tamamen yasak (wipeAllScores artık dışarıdan çalışmaz)
//   - score/distance üst sınırlı, alan tipleri ve isim uzunluğu doğrulanır
//   - scores dışındaki tüm koleksiyonlar kapalı
// Anonim auth eklenirse (bkz. DEVELOPMENT_LOG) uid bazlı sahiplik de eklenmeli.

service cloud.firestore {
  match /databases/{database}/documents {

    function validScore(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && d.avatar is int && d.avatar >= 0 && d.avatar <= 100
        && d.ts is int
        && d.mode in ['normal', 'extreme']
        && d.distance is number && d.distance >= 0 && d.distance <= 100000
        && (!('tracePts' in d) || (d.tracePts is string && d.tracePts.size() <= 200000))
        && (!('traceColor' in d) || d.traceColor is string)
        && (!('traceThickness' in d) || d.traceThickness is int)
        && (!('badges' in d) || (d.badges is string && d.badges.size() <= 64));
    }

    match /scores/{doc} {
      allow read: if true;
      allow create: if validScore(request.resource.data);
      allow update: if validScore(request.resource.data)
        // İsim değiştirilemez — başka oyuncunun kaydı "devralınamaz".
        && request.resource.data.name == resource.data.name;
      allow delete: if false;
    }

    // Referral (davet) tıklama sayacı: her yazma clicks'i tam +1 artırabilir.
    // Auth yok; düşük riskli (ödül 1 coin, cihaz başına bir kez client guard'ı var).
    match /referrals/{code} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['clicks'])
        && request.resource.data.clicks == 1;
      allow update: if request.resource.data.keys().hasOnly(['clicks'])
        && request.resource.data.clicks == resource.data.clicks + 1;
      allow delete: if false;
    }

    // Oyuncu kayıt defteri (players/{NAME#TAG}): isim#tag kimliği + en iyi skor/mesafe.
    // Auth yok → herkes herhangi bir player doc'unu yazabilir (spoof riski düşük, sadece
    // arkadaş listesinde gösterim için). Alan tipleri ve sınırlar doğrulanır.
    function validPlayer(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.tag is string && d.tag.size() == 4
        && d.avatar is int && d.avatar >= 0 && d.avatar <= 100
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && d.dist is number && d.dist >= 0 && d.dist <= 100000
        && d.ts is int;
    }
    match /players/{id} {
      allow read: if true;
      allow create, update: if validPlayer(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
