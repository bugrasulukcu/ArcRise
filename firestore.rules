rules_version = '2';
// ArcRise Firestore kuralları.
// Deploy: Firebase Console > Firestore Database > Rules sekmesine yapıştır > Publish.
//
// ÖNCE: Firebase Console > Authentication > Sign-in method > Anonymous > ENABLE.
// Oyun her cihaz için kalıcı bir anonim uid alır (arc_fb_rt refresh token'ı
// localStorage'da saklanır). Yazımlar bu uid'e bağlanır:
//   - scores / players: doc'a "owner" = uid yazılır; sadece sahibi günceller
//     → başkasının leaderboard kaydı veya NAME#TAG profili devralınamaz/spoof'lanamaz
//   - DELETE her yerde yasak
//   - tüm yazımlar auth gerektirir
// Geriye dönük uyumluluk: "owner" alanı OLMAYAN eski doc'lar bir kez herhangi bir
// authed kullanıcı tarafından sahiplenilebilir (owner'ı kendi uid'ine set ederek);
// owner set edildikten sonra kilitlenir.
//
// NOT: Coin bakiyesi tamamen client-side (localStorage) tutulur — sunucu cüzdanı
// yoktur, dolayısıyla coin miktarı bu kurallarla korunamaz (bilinen, kabul edilen
// kısıt; gerçek koruma sunucu tarafı cüzdan gerektirir).

service cloud.firestore {
  match /databases/{database}/documents {

    // Yazan kişi authed mi?
    function isAuthed() { return request.auth != null; }
    // Yeni doc'un owner alanı yazanın uid'ine eşit mi?
    function ownsNew()  { return request.resource.data.owner == request.auth.uid; }
    // Mevcut doc ya sahipsiz (eski) ya da yazana ait mi?
    function ownsOld()  { return !('owner' in resource.data) || resource.data.owner == request.auth.uid; }

    function validScore(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.score is int && d.score >= 0 && d.score <= 1000000000
        && d.avatar is int && d.avatar >= 0 && d.avatar <= 100
        && d.ts is int
        && d.mode in ['normal', 'extreme']
        && d.distance is number && d.distance >= 0 && d.distance <= 100000
        && (!('tracePts' in d) || (d.tracePts is string && d.tracePts.size() <= 200000))
        && (!('traceColor' in d) || d.traceColor is string)
        && (!('traceThickness' in d) || d.traceThickness is int)
        && (!('badges' in d) || (d.badges is string && d.badges.size() <= 64))
        && (!('owner' in d) || d.owner is string);
    }

    match /scores/{doc} {
      allow read: if true;
      allow create: if isAuthed() && validScore(request.resource.data) && ownsNew();
      allow update: if isAuthed() && validScore(request.resource.data)
        // İsim değiştirilemez — başka oyuncunun kaydı "devralınamaz".
        && request.resource.data.name == resource.data.name
        // Sadece sahibi (veya sahipsiz eski doc'u sahiplenen) günceller.
        && ownsOld() && ownsNew();
      // Hesap silme: yalnızca kayıt sahibi kendi skorunu silebilir.
      allow delete: if isAuthed() && 'owner' in resource.data && resource.data.owner == request.auth.uid;
    }

    // Referral (davet) tıklama sayacı: her yazma clicks'i tam +1 artırabilir.
    // Authed gerektirir; coin client-side olduğundan self-increment koruması
    // pratik fayda sağlamaz (cheater zaten kendine coin verebilir).
    match /referrals/{code} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.keys().hasOnly(['clicks'])
        && request.resource.data.clicks == 1;
      allow update: if isAuthed() && request.resource.data.keys().hasOnly(['clicks'])
        && request.resource.data.clicks == resource.data.clicks + 1;
      allow delete: if false;
    }

    // Oyuncu kayıt defteri (players/{NAME#TAG}): isim#tag kimliği + en iyi skor/mesafe.
    // owner = uid → NAME#TAG'i ilk alan uid sahibidir; başkası spoof edemez (race fix).
    function validPlayer(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.tag is string && d.tag.size() == 4
        && d.avatar is int && d.avatar >= 0 && d.avatar <= 100
        && d.score is int && d.score >= 0 && d.score <= 1000000000
        && d.dist is number && d.dist >= 0 && d.dist <= 100000
        && d.ts is int
        && (!('owner' in d) || d.owner is string);
    }
    match /players/{id} {
      allow read: if true;
      allow create: if isAuthed() && validPlayer(request.resource.data) && ownsNew();
      allow update: if isAuthed() && validPlayer(request.resource.data) && ownsOld() && ownsNew();
      allow delete: if false;
    }

    // Arkadaşlık istekleri / kenarları (friendreqs/{fromId__toId}).
    // parties = [from, to] (NAME#TAG). status: pending → accepted.
    // Sahiplik players/{id}.owner üzerinden doğrulanır (get ile).
    function ownsPlayer(pid) {
      return request.auth != null
        && get(/databases/$(database)/documents/players/$(pid)).data.owner == request.auth.uid;
    }
    match /friendreqs/{id} {
      allow read: if request.auth != null;
      // Oluşturma: gönderen 'from' oyuncusunun sahibi olmalı; status pending.
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.parties == [request.resource.data.from, request.resource.data.to]
        && request.resource.data.fromUid == request.auth.uid
        && ownsPlayer(request.resource.data.from);
      // Kabul: yalnızca alıcı (to'nun sahibi) pending → accepted yapabilir.
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.parties == resource.data.parties
        && ownsPlayer(resource.data.to);
      // Silme (ret / arkadaşlıktan çıkarma): iki taraftan biri.
      allow delete: if ownsPlayer(resource.data.from) || ownsPlayer(resource.data.to);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
